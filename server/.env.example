PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mynotes
# Frontend URL used as the default redirect after OAuth login.
# In development: http://localhost:5173
# For Vite preview: http://localhost:4173
# For production: https://mynotes-pooq.onrender.com
# NOTE: When using Vite preview, set this to http://localhost:4173,
# or rely on the automatic Origin-header detection (which captures
# the correct port from the browser's request).
CLIENT_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# CORS allowlist (comma-separated). Used for credentialed requests AND
# OAuth origin capture (the server remembers which frontend port initiated
# the login flow and redirects back to it).
# For Vite preview testing, include both ports:
#   ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173
# If omitted, defaults to CLIENT_URL.
# ALLOWED_ORIGINS=

SESSION_SECRET=your-session-secret-change-this-in-production
