{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyNotes",
  "version": "0.1.2",
  "identifier": "com.mynotes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/tauri-frontend-build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyNotes",
        "width": 1024,
        "height": 768,
        "minWidth": 600,
        "minHeight": 400,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFODNCOUMyMDVGNzRBQ0QKUldUTlN2Y0Z3cm1EanFTSG1NYTNFQjJYMEFqL0p6V0swWG1LTU5CbDA2akpURmtkTlRVQlVjd2kK",
      "endpoints": [
        "https://github.com/adarsh-devx/MyNote/releases/latest/download/latest.json"
      ]
    }
  }
}
